# FlowDeck — test environment.
#
# core.init() reads these before any package init runs, so they must be
# exported into the test process (os.Setenv inside a test is too late):
#
#   set -a && source .env.test && set +a && go test ./...
#
# The suite is SQLite on disk: no Postgres needed for the fast cycle, and
# the file survives the test process (the assertions filter by execution id
# — they tolerate runs left by earlier tests). The e2e job (Postgres 18)
# sets the same two variables itself (.github/workflows/ci.yml) and runs
#   go test -tags e2e -run TestE2E -p 1 ./...
#
# The same env is what docker compose sets for the production container
# (.env), so the env-driven lifecycle is tested end to end.
DBOS_APP_NAME=flowdeck_test
DBOS_SYSTEM_DATABASE_URL="sqlite:/tmp/flowdeck-test.db"
