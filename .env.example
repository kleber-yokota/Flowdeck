# FlowDeck — variáveis de ambiente (infra, compose em uma máquina)
# Usado pelo docker-compose.yml; cada serviço lê só o seu escopo.
# Copie para `.env` e ajuste se necessário: cp .env.example .env

# --- Postgres 18 (serviço `db`) ---
POSTGRES_USER=flowdeck
POSTGRES_PASSWORD=flowdeck
POSTGRES_DB=flowdeck
# Porta publicada na máquina (container interno é sempre 5432)
# Host-side publish (container interno continua em 5432; 5432 da máquina está ocupado)
POSTGRES_PORT=15432

# --- FlowDeck (serviço `flowdeck`) ---
# Nome do app DBOS (identifica o app no sistema database; 3-256 chars, só [a-z0-9_-])
DBOS_APP_NAME=flowdeck
# Sistema database do DBOS — na rede interna do compose (host = serviço `db`, não localhost)
DBOS_SYSTEM_DATABASE_URL=postgres://flowdeck:flowdeck@db:5432/flowdeck?sslmode=disable
# Porta do webserver HTMX publicada na máquina (container interno é sempre 8080)
# Host-side publish (container interno continua em 8080; 8080 da máquina está ocupado)
FLOWDECK_HTTP_PORT=18080
